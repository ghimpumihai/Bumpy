# Copy to infra/.env (gitignored) and fill in. Read by infra/tf.ps1; nothing here is a secret
# (logins go through `az login`), but keep it out of git anyway.
# Write values without quotes, except the JSON list, which is written as-is.

# --- Azure account (az account show --query "{sub:id, tenant:tenantId}" -o table) ---
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# --- Stack settings ---
# Where budget and error alerts are emailed.
TF_VAR_alert_email=
# Your Entra object ID (az ad signed-in-user show --query id -o tsv), plus teammates', as a JSON list.
TF_VAR_admin_object_ids=[]
# Optional overrides (defaults shown).
# TF_VAR_project=roadride
# TF_VAR_location=northeurope
# TF_VAR_budget_amount=50
# Set to true only if the database still can't reach Entra ID (AadAuthPrincipalCreationFailed); ~$1/day.
# TF_VAR_psql_nat_gateway_enabled=true

# --- Terraform state (filled in automatically by `.\tf.ps1 bootstrap`) ---
TFSTATE_RESOURCE_GROUP=
TFSTATE_STORAGE_ACCOUNT=
TFSTATE_CONTAINER=tfstate
TFSTATE_KEY=main.tfstate
